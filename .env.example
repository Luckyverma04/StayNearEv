# Copy to .env and fill in your values. Never commit the real .env.

# Server
PORT=3002
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Cloudinary (station photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=StayNearEV
ADMIN_NOTIFY_EMAIL=
EMAIL_VERIFICATION=false

# Public chargers (Open Charge Map, optional)
OCM_API_KEY=

# One-time admin setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SETUP_KEY=
